#!/bin/bash
# Open Omaflow as its own window. The bar chip is a separate plugin.
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck disable=SC1091
source "$root/scripts/qml_imports.sh"
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export QML_IMPORT_PATH="$(qml_import_path)${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
exec quickshell -n -p "$root/OmaflowApp.qml"
