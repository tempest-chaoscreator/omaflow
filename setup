#!/bin/bash
# This generation does not install packages or a root helper.
# coolercontrold is installed by the user. The client always uses
# http://127.0.0.1:11987. There is no host or port to type.
echo "Omaflow does not install packages."
echo "Install coolercontrold yourself. Omaflow talks only to 127.0.0.1:11987."
echo "Start it for this session. Leave it disabled at boot:"
echo "  sudo systemctl start coolercontrold"
echo "A saved token connects with no prompt. A fresh daemon gets Silent, Performance, Fixed, and Hell."
echo "If the password was changed, Settings asks for it once and does not keep it."
exit 0
